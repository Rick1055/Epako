# Public values only: everything prefixed VITE_ ends up in the browser. Never put a secret here.
# Copy to .env and fill in. The build refuses missing contact values, and sample values without VITE_DEMO_CONTACT=true.
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_PHONE=
VITE_DEMO_CONTACT=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_TURNSTILE_SITE_KEY=
